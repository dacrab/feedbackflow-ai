# =============================================================================
# REQUIRED - Database
# =============================================================================
# Full postgres connection string from Neon project settings
DATABASE_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require&channel_binding=require"

# =============================================================================
# REQUIRED - Better Auth
# =============================================================================
# Base URL of your app; in production set this to your deployed URL
BETTER_AUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="your-better-auth-secret-here"

# =============================================================================
# REQUIRED - Encryption Key
# =============================================================================
# Used to encrypt sensitive data like API keys stored in the database
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY="your-encryption-key-here"

# =============================================================================
# OPTIONAL - OAuth Providers (leave empty to disable)
# =============================================================================
# Get credentials from GitHub Developer Settings
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Get credentials from Google Cloud Console
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# =============================================================================
# OPTIONAL - LLM API Keys
# =============================================================================
# Users configure provider in app settings. These are fallbacks if user has no key.
GOOGLE_GENERATIVE_AI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# =============================================================================
# OPTIONAL - Cron Security
# =============================================================================
# CRON_SECRET: Vercel automatically sets this in production for cron jobs
# CRON_TOKEN: Custom token for manual testing via x-cron-token header
# If neither matches, endpoints fall back to requiring user authentication
CRON_SECRET=""
CRON_TOKEN=""

# =============================================================================
# OPTIONAL - Slack Notifications
# =============================================================================
# Global webhook for system alerts (high severity feedback, etc.)
SLACK_WEBHOOK_URL=""
