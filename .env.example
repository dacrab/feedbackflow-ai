# Neon Postgres connection (Drizzle + Neon)
# Full postgres connection string from Neon project settings
DATABASE_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require&channel_binding=require"

# Auth.js (NextAuth)
# Base URL of your app; in production set this to your deployed URL
NEXTAUTH_URL="http://localhost:3000"
# Generate a strong random secret for production
NEXTAUTH_SECRET="your-nextauth-secret-here"

# LLM provider configuration
# One of: openai | anthropic | google
LLM_PROVIDER="openai"
OPENAI_API_KEY="your-openai-api-key-here"
ANTHROPIC_API_KEY="your-anthropic-api-key-here"

# GitHub ingest source (used by /api/ingest)
# Example: owner="vercel", repo name="next.js"
GITHUB_REPO_OWNER="your-github-owner"
GITHUB_REPO_NAME="your-github-repo"
GITHUB_TOKEN="optional-github-token-for-higher-rate-limits"

# Cron token (shared secret for /api/ingest and /api/digest)
# Set to a long random string and configure the same in any cron caller
CRON_TOKEN="your-cron-token-here"

# Optional Slack webhook for global alerts
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/..."
