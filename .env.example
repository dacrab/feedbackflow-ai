# =============================================================================
# Secrets are managed by Doppler (https://dashboard.doppler.com/workplace/projects)
# Run `doppler setup` to link this repo if not already configured.
# Run `doppler run -- <command>` to inject secrets automatically.
#
# If you don't use Doppler, copy this file to .env.local and fill in the values
# below (Next.js loads it automatically; it is gitignored).
# =============================================================================

# Database (Neon/PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key
CLERK_SECRET_KEY=sk_test_your-secret-key
CLERK_WEBHOOK_SECRET=whsec_your-webhook-secret

# Encryption (AES-256-GCM for LLM keys, GitHub tokens, Slack webhooks)
ENCRYPTION_KEY=your-encryption-key-generate-with-openssl-rand-hex-32

# Cron job auth — the bearer token Vercel sends to /api/cron
CRON_SECRET=your-cron-bearer-token

# Sentry (optional — disable by leaving unset)
SENTRY_DSN=https://your-dsn@sentry.io/project-id
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/project-id
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug
SENTRY_AUTH_TOKEN=your-sentry-auth-token
