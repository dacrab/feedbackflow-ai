# =============================================================================
# Secrets are managed by Doppler (https://dashboard.doppler.com/workplace/projects)
# Run `doppler setup` to link this repo if not already configured.
# Run `doppler run -- <command>` to inject secrets automatically.
#
# If you don't use Doppler, copy this file to .env and fill in the values below.
# =============================================================================

# Database (Neon/PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Auth (Better Auth)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=your-auth-secret-generate-with-openssl-rand-hex-32

# Encryption
ENCRYPTION_KEY=your-encryption-key-generate-with-openssl-rand-hex-32

# OAuth providers (optional — disable by leaving unset)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Cron job auth (optional — one of these is required for /api/cron)
CRON_SECRET=your-cron-bearer-token
CRON_TOKEN=your-cron-token

# Sentry (optional — disable by leaving unset)
SENTRY_DSN=https://your-dsn@sentry.io/project-id
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/project-id
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug
SENTRY_AUTH_TOKEN=your-sentry-auth-token
