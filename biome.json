{
  "$schema": "https://biomejs.dev/schemas/2.2.0/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "ignoreUnknown": true },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": {
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "error",
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error"
      },
      "suspicious": {
        "noUnknownAtRules": "off",
        "noConsole": "warn",
        "noExplicitAny": "error",
        "noDoubleEquals": "error",
        "noImplicitAnyLet": "error"
      },
      "complexity": {
        "useLiteralKeys": "off",
        "noForEach": "off",
        "noExcessiveCognitiveComplexity": {
          "level": "warn",
          "options": { "maxAllowedComplexity": 35 }
        }
      },
      "style": {
        "useConst": "error",
        "useBlockStatements": "error",
        "useSelfClosingElements": "error",
        "useTemplate": "error",
        "noNonNullAssertion": "warn"
      },
      "security": { "noDangerouslySetInnerHtml": "error", "noGlobalEval": "error" },
      "performance": { "noAccumulatingSpread": "warn", "noDelete": "warn" },
      "a11y": { "useButtonType": "error", "useAltText": "error", "noAutofocus": "warn" }
    },
    "domains": { "next": "all", "react": "all" }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
