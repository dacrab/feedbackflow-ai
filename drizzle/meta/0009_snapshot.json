  "views": {
    "public.feedback_topics": {
      "columns": {
        "user_id": {
          "name": "user_id",
          "type": "text",
          "primaryKey": false,
          "notNull": true
        }
      },
      "definition": "select \"feedback_items\".\"user_id\", t.topic as \"topic\", MAX(DATE(\"feedback_items\".\"original_timestamp\")) as \"day\", COUNT(*) as \"cnt\" from \"feedback_items\" inner join \"feedback_analyses\" on \"feedback_analyses\".\"feedback_item_id\" = \"feedback_items\".\"id\" inner join LATERAL jsonb_array_elements_text(\"feedback_analyses\".\"topics\") AS t(topic) on true group by \"feedback_items\".\"user_id\", t.topic",
      "name": "feedback_topics",
      "schema": "public",
      "isExisting": false,
      "materialized": false
    },
