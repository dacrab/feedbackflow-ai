{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["src/db/seed.ts", "src/app/**", "src/components/**", "src/lib/**"],
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": ["doppler"],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "warn",
    "exports": "warn",
    "types": "error",
    "duplicates": "off"
  }
}
