{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["src/db/seed.ts"],
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": ["doppler"],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "warn",
    "exports": "warn",
    "types": "error",
    "duplicates": "error"
  }
}
