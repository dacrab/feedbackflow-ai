{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": ["src/lib/types/**"],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "off",
    "exports": "warn",
    "types": "error",
    "duplicates": "warn"
  }
}
