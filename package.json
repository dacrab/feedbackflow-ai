{
  "name": "feedbackflow-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "doppler run -- next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . --error-on-warnings",
    "lint:fix": "biome check . --write --error-on-warnings",
    "knip": "doppler run -- knip",
    "check": "bun run typecheck && bun run lint && bun run contrast && bun run test:coverage && bun run knip && bun run db:check",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "doppler run -- drizzle-kit generate",
    "db:migrate": "doppler run -- drizzle-kit migrate",
    "db:seed": "doppler run -- bun src/db/seed.ts",
    "db:studio": "doppler run -- drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "db:push": "doppler run -- drizzle-kit push",
    "contrast": "node scripts/check-contrast.mjs",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.49",
    "@ai-sdk/google": "^4.0.63",
    "@ai-sdk/openai": "^4.0.57",
    "@clerk/nextjs": "^7.5.14",
    "@neondatabase/serverless": "^1.1.0",
    "@sentry/nextjs": "^11.8.0",
    "@tabler/icons-react": "^3.44.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.91",
    "drizzle-orm": "^0.45.2",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.9.2",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "svix": "^2.8.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "browserslist": "^4.28.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "drizzle-kit": "0.31.11",
    "jsdom": "30.1.3",
    "knip": "6.42.1",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "packageManager": "bun@1.4.3"
}
