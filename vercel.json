{
  "crons": [
    {
      "path": "/api/ingest",
      "schedule": "0 7 * * *",
      "headers": {
        "x-cron-token": "${CRON_TOKEN}"
      }
    },
    {
      "path": "/api/digest",
      "schedule": "30 7 * * *",
      "headers": {
        "x-cron-token": "${CRON_TOKEN}"
      }
    }
  ]
}
